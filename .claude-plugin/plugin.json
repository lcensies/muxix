{
  "name": "muxix-status",
  "description": "Display Claude agent status in tmux window names via muxix",
  "version": "1.0.0",
  "author": {
    "name": "muxix contributors"
  },
  "repository": "https://github.com/lcensies/muxix",
  "license": "MIT",
  "keywords": [
    "tmux",
    "muxix",
    "status",
    "agent"
  ],
  "commands": "./commands/",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "muxix set-window-status working"
          },
          {
            "type": "command",
            "command": "muxix signal working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "muxix set-window-status waiting"
          },
          {
            "type": "command",
            "command": "muxix signal needs-input"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "muxix set-window-status working"
          },
          {
            "type": "command",
            "command": "muxix signal working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "muxix set-window-status done"
          },
          {
            "type": "command",
            "command": "muxix signal turn-done"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "muxix signal session-ready"
          },
          {
            "type": "command",
            "command": "muxix hooks-report"
          }
        ]
      }
    ]
  }
}
