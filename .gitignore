# Per-repo agent homes written by `muxix setup` (preferences, not product).
# The two files the binary compiles in stay tracked:
#   .pi/extensions/muxix-status.ts, .codex/hooks/muxix-status.json
.claude/
.gemini/
.opencode/
opencode.json
.pi/*
!.pi/extensions/
.codex/*
!.codex/hooks/

# muxix-managed MCP config, generated from the `mcp:` section of .muxix.yaml
.mcp.json

